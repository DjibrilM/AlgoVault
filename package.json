    "vm:build": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --arch all",
    "vm:build:arm64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --arch arm64",
    "vm:build:x64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --arch x64",
    "vm:kernel": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-kernel --arch all",
    "vm:kernel:arm64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-kernel --arch arm64",
    "vm:kernel:x64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-kernel --arch x64",
    "vm:qemu": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-qemu --arch all",
    "vm:qemu:arm64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-qemu --arch arm64",
    "vm:qemu:x64": "./electron/modules/engine-runner/scripts/build-vm-assets.sh --only-qemu --arch x64",
    "vm:rootfs": "./electron/modules/engine-runner/scripts/build-rootfs.sh --arch all",
    "vm:rootfs:arm64": "./electron/modules/engine-runner/scripts/build-rootfs.sh --arch arm64",
    "vm:rootfs:x64": "./electron/modules/engine-runner/scripts/build-rootfs.sh --arch x64",
    "vm:test": "node electron/modules/engine-runner/scripts/smoke-test.ts",
    "vm:test:arm64": "node electron/modules/engine-runner/scripts/smoke-test.ts --arch arm64",
    "vm:test:x64": "node electron/modules/engine-runner/scripts/smoke-test.ts --arch x64",
